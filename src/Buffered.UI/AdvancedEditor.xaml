<UserControl x:Class="Buffered.UI.AdvancedEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Buffered.UI"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <!-- line icons drawn as paths; they take the colour of the button's text, so they dim when the button is disabled -->
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
        </Style>
        <!-- the small diamond beside an animatable slider -->
        <Style x:Key="KeyDiamond" TargetType="Button">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,-3,0,0"/><Setter Property="Content" Value="&#x25C7;"/>
        </Style>
        <Style x:Key="ToolGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: where you are, what is happening, and the things you do once (save, export) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Back" Height="32" Click="Back_Click" ToolTip="Back to the clip (Esc)"/>
                <TextBlock x:Name="TitleText" Margin="14,0,0,0" MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="DirtyDot" Text="&#x25CF;" Margin="8,1,0,0" VerticalAlignment="Center" Foreground="#E6D370" Visibility="Collapsed" ToolTip="Unsaved changes"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" Margin="18,0,18,0" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                       Text="Space plays · S cuts · Delete removes · C razor · Ctrl+D duplicates · M marks · L loops"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="UndoButton" Height="32" Width="40" Padding="0" Margin="0,0,4,0" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"><Path Style="{StaticResource ToolIcon}" Data="M8,4 L3,9 L8,14 M3,9 H14 C18.5,9 21,12 21,15 C21,18 18.5,21 14,21 H9"/></Button>
                <Button x:Name="RedoButton" Height="32" Width="40" Padding="0" Margin="0,0,14,0" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"><Path Style="{StaticResource ToolIcon}" Data="M16,4 L21,9 L16,14 M21,9 H10 C5.5,9 3,12 3,15 C3,18 5.5,21 10,21 H15"/></Button>
                <ComboBox x:Name="AspectBox" Width="168" Height="32" Margin="0,0,8,0" SelectionChanged="Aspect_Changed" ToolTip="The shape of the video: wide, tall (phone), square..."/>
                <Button x:Name="ProjectButton" Content="Project" Height="32" Margin="0,0,8,0" Click="Project_Click" ToolTip="Save, open and manage edits (Ctrl+S saves)"/>
                <Button x:Name="ExportButton" Content="Export" Height="32" MinWidth="86" Style="{StaticResource PrimaryButton}" Click="Export_Click" ToolTip="Save this edit as a video (Ctrl+E)"/>
            </StackPanel>
        </Grid>

        <!-- Preview and properties -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="214" MaxWidth="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*" MinWidth="262" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Media and text -->
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <RadioButton x:Name="TabMedia" Content="Media" GroupName="PanelTab" IsChecked="True" Style="{StaticResource SegButton}" Height="30" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabText" Content="Text" GroupName="PanelTab" Style="{StaticResource SegButton}" Height="30" Checked="Tab_Checked"/>
                    </UniformGrid>
                    <Grid x:Name="MediaTab" Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button Content="Import files…" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,8" Click="Import_Click" ToolTip="Videos, pictures or sound files from your computer"/>
                        <ListBox x:Name="MediaList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseMove="MediaList_MouseMove" PreviewMouseLeftButtonDown="MediaList_MouseDown" MouseDoubleClick="MediaList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="56" Height="32" CornerRadius="3" Background="#2A2A2A" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <StackPanel x:Name="TextTab" Grid.Row="1" Visibility="Collapsed">
                        <Button Content="Add heading" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,8" Click="AddHeading_Click" FontSize="17" FontWeight="Bold"/>
                        <Button Content="Add subtitle" HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,8" Click="AddSubtitle_Click" FontSize="14"/>
                        <Button Content="Add body text" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,10" Click="AddBody_Click" FontSize="12"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Text goes on its own lane at the playhead. Click it on the timeline to change the words, size, colour and where it sits; drag it in the picture to move it."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="Black" CornerRadius="6" ClipToBounds="True" SizeChanged="Stage_SizeChanged" x:Name="StageHost">
                <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="225" ClipToBounds="True">
                    <MediaElement x:Name="Video2" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" IsMuted="True" Opacity="0" MediaOpened="Video2_Opened"/>
                    <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                                  MediaOpened="Video_Opened" MediaFailed="Video_Failed"/>
                    <TextBlock x:Name="EmptyText" Text="Nothing here at the playhead" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Canvas x:Name="Overlay" ClipToBounds="True" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PropsPanel" Margin="0,0,10,0">
                    <TextBlock x:Name="PropsTitle" Text="Nothing selected" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PropsHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Click an item on the timeline to change its opacity, volume and fades."/>
                    <StackPanel x:Name="PropsBody" Visibility="Collapsed" Margin="12,10,10,4">
                        <DockPanel x:Name="OpacityRow" Margin="0,0,0,10"><Button x:Name="KeyOpacity" Tag="Opacity" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Opacity"/></DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel x:Name="VolumeRow" Margin="0,0,0,10"><Button x:Name="KeyVolume" Tag="Volume" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Volume"/></DockPanel>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock x:Name="FadeInValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Fade in"/></DockPanel>
                        <Slider x:Name="FadeInSlider" Minimum="0" Maximum="5" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock x:Name="FadeOutValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Fade out"/></DockPanel>
                        <Slider x:Name="FadeOutSlider" Minimum="0" Maximum="5" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel x:Name="SpeedRow" Margin="0,0,0,10"><TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Speed"/></DockPanel>
                        <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <StackPanel x:Name="WordsPanel">
                            <TextBlock Text="Words" Margin="0,0,0,4"/>
                            <TextBox x:Name="WordsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="120" Margin="0,0,0,10" TextChanged="WordsBox_Changed"/>
                            <DockPanel Margin="0,0,0,10"><Button x:Name="KeySize" Tag="TextSize" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Size"/></DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="2" Maximum="30" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <TextBlock Text="Colour" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="Swatches" Margin="0,0,0,10"/>
                            <TextBlock Text="Font" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FontBox" Margin="0,0,0,8" SelectionChanged="Font_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <ToggleButton x:Name="BoldBtn" Content="B" FontWeight="Bold" Width="34" Height="30" Margin="0,0,6,0" Click="Style_Click" ToolTip="Bold"/>
                                <ToggleButton x:Name="ItalicBtn" Content="I" FontStyle="Italic" Width="34" Height="30" Click="Style_Click" ToolTip="Italic"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,10"><TextBlock x:Name="OutlineValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Outline"/></DockPanel>
                            <Slider x:Name="OutlineSlider" Minimum="0" Maximum="20" Margin="0,-6,0,6" ValueChanged="Outline_Changed"/>
                            <WrapPanel x:Name="OutlineSwatches" Margin="0,0,0,10"/>
                            <TextBlock Text="Background box" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="BoxSwatches" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel x:Name="CropPanel" Margin="0,0,0,2">
                            <TextBlock Text="Crop" Margin="0,0,0,6"/>
                            <DockPanel><TextBlock x:Name="CropLValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Left" Style="{StaticResource Caption}"/></DockPanel>
                            <Slider x:Name="CropLSlider" Minimum="0" Maximum="90" Margin="0,-2,0,6" ValueChanged="Prop_Changed"/>
                            <DockPanel><TextBlock x:Name="CropTValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Top" Style="{StaticResource Caption}"/></DockPanel>
                            <Slider x:Name="CropTSlider" Minimum="0" Maximum="90" Margin="0,-2,0,6" ValueChanged="Prop_Changed"/>
                            <DockPanel><TextBlock x:Name="CropRValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Right" Style="{StaticResource Caption}"/></DockPanel>
                            <Slider x:Name="CropRSlider" Minimum="0" Maximum="90" Margin="0,-2,0,6" ValueChanged="Prop_Changed"/>
                            <DockPanel><TextBlock x:Name="CropBValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Bottom" Style="{StaticResource Caption}"/></DockPanel>
                            <Slider x:Name="CropBSlider" Minimum="0" Maximum="90" Margin="0,-2,0,12" ValueChanged="Prop_Changed"/>
                        </StackPanel>
                        <StackPanel x:Name="PlacePanel">
                            <StackPanel x:Name="FitRow" Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Fit in the frame" Height="30" Margin="0,0,6,0" Click="FitVideo_Click" ToolTip="Show the whole picture, with bars if its shape differs"/>
                                <Button Content="Fill the frame" Height="30" Click="FillVideo_Click" ToolTip="Zoom in until the picture covers the whole frame (the edges are cut off)"/>
                            </StackPanel>
                            <TextBlock x:Name="LayoutLabel" Text="Picture in picture" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="LayoutRow" Margin="0,0,0,12">
                                <Button Content="↖" Tag="TL" Width="34" Height="30" Margin="0,0,6,6" Click="Layout_Click" ToolTip="Small, in the top left"/>
                                <Button Content="↗" Tag="TR" Width="34" Height="30" Margin="0,0,6,6" Click="Layout_Click" ToolTip="Small, in the top right"/>
                                <Button Content="↙" Tag="BL" Width="34" Height="30" Margin="0,0,6,6" Click="Layout_Click" ToolTip="Small, in the bottom left"/>
                                <Button Content="↘" Tag="BR" Width="34" Height="30" Margin="0,0,6,6" Click="Layout_Click" ToolTip="Small, in the bottom right"/>
                                <Button Content="●" Tag="C" Width="34" Height="30" Margin="0,0,6,6" Click="Layout_Click" ToolTip="Small, in the middle"/>
                            </WrapPanel>
                            <DockPanel Margin="0,0,0,10"><Button x:Name="KeyRotate" Tag="Rotation" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="RotateValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Turn"/></DockPanel>
                            <Slider x:Name="RotateSlider" Minimum="-180" Maximum="180" TickFrequency="45" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <DockPanel Margin="0,0,0,10"><Button x:Name="KeyScale" Tag="Scale" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Scale"/></DockPanel>
                            <Slider x:Name="ScaleSlider" Minimum="5" Maximum="400" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <DockPanel Margin="0,0,0,10"><Button x:Name="KeyPosX" Tag="PosX" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="PosXValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Across"/></DockPanel>
                            <Slider x:Name="PosXSlider" Minimum="0" Maximum="100" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <DockPanel Margin="0,0,0,10"><Button x:Name="KeyPosY" Tag="PosY" Style="{StaticResource KeyDiamond}" DockPanel.Dock="Right" Click="Key_Click" MouseRightButtonUp="Key_RightClick" ToolTip="Animate: add or remove a keyframe at the playhead (right-click: remove the animation)"/><TextBlock x:Name="PosYValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Down"/></DockPanel>
                            <Slider x:Name="PosYSlider" Minimum="0" Maximum="100" Margin="0,-6,0,0" ValueChanged="Prop_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <!-- Transport and editing tools sit right above the timeline they work on -->
        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.Resources>
                <!-- compact buttons, so the playback, tools and view controls fit side by side in a narrow window -->
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="9,0"/><Setter Property="MinWidth" Value="0"/></Style>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}"><Setter Property="Padding" Value="9,0"/><Setter Property="MinWidth" Value="0"/></Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Content="Play" Height="32" MinWidth="64" Click="Play_Click" ToolTip="Play or pause (Space)"/>
            <TextBlock x:Name="ClockText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" Text="0:00.0 / 0:00.0"/>
            <StackPanel x:Name="JobPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"/>
                <TextBlock x:Name="JobText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <ToggleButton x:Name="RazorButton" Height="32" Width="40" Margin="0,0,4,0" Click="Razor_Click" ToolTip="Razor: click an item to cut it there (C). Alt+click does the same." AutomationProperties.Name="Razor"><Path Style="{StaticResource ToolIcon}" Data="M9,6 A3,3 0 1 1 3,6 A3,3 0 1 1 9,6 M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 M8.2,8 L21,19 M8.2,16 L21,5"/></ToggleButton>
                <Button Height="32" Width="40" Margin="0,0,4,0" Click="Split_Click" ToolTip="Split: cut the selected items at the playhead (S)" AutomationProperties.Name="Split"><Path Style="{StaticResource ToolIcon}" Data="M12,2 V22 M4,7 H20 V17 H4 Z"/></Button>
                <Button Height="32" Width="40" Margin="0,0,4,0" Click="Delete_Click" ToolTip="Delete the selected items (Delete). Shift+Delete closes the gap." AutomationProperties.Name="Delete"><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE74D;"/></Button>
                <Button x:Name="UnlinkButton" Height="32" Width="40" Margin="0,0,14,0" Click="Unlink_Click" ToolTip="Unlink: let the picture and its sound be moved on their own" AutomationProperties.Name="Unlink"><Grid><TextBlock Style="{StaticResource ToolGlyph}" Text="&#xE71B;"/><Path Style="{StaticResource ToolIcon}" Data="M3,21 L21,3"/></Grid></Button>
                <Button x:Name="TransitionButton" Height="32" Width="40" Margin="0,0,4,0" Click="Transition_Click" ToolTip="Transition: fade pictures and sound through black where two items meet (select one of them first)" AutomationProperties.Name="Transition"><Path Style="{StaticResource ToolIcon}" Data="M3,5 L11,12 L3,19 Z M21,5 L13,12 L21,19 Z"/></Button>
                <Button Height="32" Width="40" Click="AddLane_Click" ToolTip="Add lane: a picture lane or a sound lane. Right-click an empty lane's name to remove it." AutomationProperties.Name="Add lane"><Path Style="{StaticResource ToolIcon}" Data="M3,6 H21 M3,12 H12 M3,18 H21 M18,9 V15 M15,12 H21"/></Button>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <ToggleButton x:Name="SnapToggle" IsChecked="True" Height="32" Width="40" Margin="0,0,4,0" Click="Snap_Click" ToolTip="Snap: stick to edges, markers and the playhead while dragging" AutomationProperties.Name="Snap"><Path Style="{StaticResource ToolIcon}" Data="M6,3 V11 A6,6 0 0 0 18,11 V3 M6,8 H10 M14,8 H18"/></ToggleButton>
                <ToggleButton x:Name="RippleToggle" Height="32" Width="40" Margin="0,0,8,0" ToolTip="Magnetic: the main picture lane never has gaps (they close as you move, trim or delete), and Delete closes the gap it leaves (Shift+Delete does the opposite)" AutomationProperties.Name="Ripple"><Path Style="{StaticResource ToolIcon}" Data="M2,12 H7 M22,12 H17 M9,6 L12,12 L9,18 M15,6 L12,12 L15,18"/></ToggleButton>
                <Button Height="32" Width="40" Margin="0,0,8,0" Click="Fit_Click" ToolTip="Fit: zoom to show everything" AutomationProperties.Name="Fit"><Path Style="{StaticResource ToolIcon}" Data="M4,9 V4 H9 M20,9 V4 H15 M4,15 V20 H9 M20,15 V20 H15"/></Button>
                <Slider x:Name="ZoomSlider" Width="80" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="Zoom_Changed" ToolTip="Zoom (Ctrl + mouse wheel on the timeline)"/>
            </StackPanel>
        </Grid>

        <!-- Timeline -->
        <Border x:Name="TimelineCard" Grid.Row="3" Style="{StaticResource Card}" Padding="0" Height="262">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <local:TimelineView x:Name="Tl"/>
                <ScrollBar x:Name="HScroll" Grid.Row="1" Orientation="Horizontal" Margin="118,0,0,0" ValueChanged="HScroll_Changed"/>
            </Grid>
        </Border>

        <!-- The page when no edit is open -->
        <Border x:Name="StartPanel" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Margin="-16,-12,-16,-14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <TextBlock Text="Editor" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Cut, arrange and fade clips, add text and pictures, then export a video. You don't need a clip to start: add them from the list on the left once you're in." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="New edit" Height="38" MinWidth="120" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartNew_Click"/>
                    <Button Content="Open a saved edit…" Height="38" Click="StartOpen_Click"/>
                </StackPanel>
                <TextBlock x:Name="RecentHeader" Text="Recent edits" FontWeight="SemiBold" Margin="0,26,0,8"/>
                <ListBox x:Name="RecentList" MaxHeight="260" BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="You can also drop a saved edit onto the window." Style="{StaticResource Caption}" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
