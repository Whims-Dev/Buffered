<UserControl x:Class="Buffered.UI.AdvancedEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Buffered.UI"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar: where you are, what is happening, and the things you do once (save, export) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Back" Height="32" Click="Back_Click" ToolTip="Back to the clip (Esc)"/>
                <TextBlock x:Name="TitleText" Margin="14,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="DirtyDot" Text="&#x25CF;" Margin="8,1,0,0" VerticalAlignment="Center" Foreground="#E6D370" Visibility="Collapsed" ToolTip="Unsaved changes"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"
                       Text="Space plays · S cuts · Delete removes · C razor · Ctrl+Z undoes · Ctrl+wheel zooms"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="ProjectButton" Content="Project" Height="32" Margin="0,0,8,0" Click="Project_Click" ToolTip="Save, open and manage edits (Ctrl+S saves)"/>
                <Button x:Name="ExportButton" Content="Export" Height="32" MinWidth="86" Style="{StaticResource PrimaryButton}" Click="Export_Click" ToolTip="Save this edit as a video (Ctrl+E)"/>
            </StackPanel>
        </Grid>

        <!-- Preview and properties -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="214" MaxWidth="320"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*" MinWidth="262" MaxWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Media and text -->
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <RadioButton x:Name="TabMedia" Content="Media" GroupName="PanelTab" IsChecked="True" Style="{StaticResource SegButton}" Height="30" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabText" Content="Text" GroupName="PanelTab" Style="{StaticResource SegButton}" Height="30" Checked="Tab_Checked"/>
                    </UniformGrid>
                    <Grid x:Name="MediaTab" Grid.Row="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Button Content="Import files…" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,8" Click="Import_Click" ToolTip="Videos, pictures or sound files from your computer"/>
                        <ListBox x:Name="MediaList" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseMove="MediaList_MouseMove" PreviewMouseLeftButtonDown="MediaList_MouseDown" MouseDoubleClick="MediaList_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Width="56" Height="32" CornerRadius="3" Background="#2A2A2A" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="12.5"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <StackPanel x:Name="TextTab" Grid.Row="1" Visibility="Collapsed">
                        <Button Content="Add heading" HorizontalAlignment="Stretch" Height="38" Margin="0,0,0,8" Click="AddHeading_Click" FontSize="17" FontWeight="Bold"/>
                        <Button Content="Add subtitle" HorizontalAlignment="Stretch" Height="34" Margin="0,0,0,8" Click="AddSubtitle_Click" FontSize="14"/>
                        <Button Content="Add body text" HorizontalAlignment="Stretch" Height="30" Margin="0,0,0,10" Click="AddBody_Click" FontSize="12"/>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Text goes on its own lane at the playhead. Click it on the timeline to change the words, size, colour and where it sits; drag it in the picture to move it."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="Black" CornerRadius="6" ClipToBounds="True" SizeChanged="Stage_SizeChanged" x:Name="StageHost">
                <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" Height="225">
                    <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                                  MediaOpened="Video_Opened" MediaFailed="Video_Failed"/>
                    <TextBlock x:Name="EmptyText" Text="Nothing here at the playhead" Foreground="#99FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Canvas x:Name="Overlay" ClipToBounds="True" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseUp"/>
                </Grid>
            </Border>

            <Border Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Card}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PropsPanel" Margin="0,0,10,0">
                    <TextBlock x:Name="PropsTitle" Text="Nothing selected" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PropsHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" Text="Click an item on the timeline to change its opacity, volume and fades."/>
                    <StackPanel x:Name="PropsBody" Visibility="Collapsed" Margin="0,10,0,0">
                        <DockPanel x:Name="OpacityRow" Margin="0,0,0,10"><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Opacity"/></DockPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel x:Name="VolumeRow" Margin="0,0,0,10"><TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Volume"/></DockPanel>
                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock x:Name="FadeInValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Fade in"/></DockPanel>
                        <Slider x:Name="FadeInSlider" Minimum="0" Maximum="5" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel Margin="0,0,0,10"><TextBlock x:Name="FadeOutValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Fade out"/></DockPanel>
                        <Slider x:Name="FadeOutSlider" Minimum="0" Maximum="5" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <DockPanel x:Name="SpeedRow" Margin="0,0,0,10"><TextBlock x:Name="SpeedValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Speed"/></DockPanel>
                        <Slider x:Name="SpeedSlider" Minimum="0.25" Maximum="4" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                        <StackPanel x:Name="WordsPanel">
                            <TextBlock Text="Words" Margin="0,0,0,4"/>
                            <TextBox x:Name="TextInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="120" Margin="0,0,0,10" TextChanged="TextInput_Changed"/>
                            <DockPanel Margin="0,0,0,10"><TextBlock x:Name="SizeValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Size"/></DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="2" Maximum="30" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <TextBlock Text="Colour" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="Swatches" Margin="0,0,0,10"/>
                        </StackPanel>
                        <StackPanel x:Name="PlacePanel">
                            <DockPanel Margin="0,0,0,10"><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Scale"/></DockPanel>
                            <Slider x:Name="ScaleSlider" Minimum="5" Maximum="300" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <DockPanel Margin="0,0,0,10"><TextBlock x:Name="PosXValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Across"/></DockPanel>
                            <Slider x:Name="PosXSlider" Minimum="0" Maximum="100" Margin="0,-6,0,10" ValueChanged="Prop_Changed"/>
                            <DockPanel Margin="0,0,0,10"><TextBlock x:Name="PosYValue" DockPanel.Dock="Right" Style="{StaticResource Caption}"/><TextBlock Text="Down"/></DockPanel>
                            <Slider x:Name="PosYSlider" Minimum="0" Maximum="100" Margin="0,-6,0,0" ValueChanged="Prop_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <!-- Transport and editing tools sit right above the timeline they work on -->
        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Content="Play" Height="32" MinWidth="80" Click="Play_Click" ToolTip="Play or pause (Space)"/>
            <TextBlock x:Name="ClockText" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" Text="0:00.0 / 0:00.0"/>
            <StackPanel x:Name="JobPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="70" Height="4" VerticalAlignment="Center"/>
                <TextBlock x:Name="JobText" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="UndoButton" Content="Undo" Height="32" Margin="0,0,4,0" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"/>
                <Button x:Name="RedoButton" Content="Redo" Height="32" Margin="0,0,14,0" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)"/>
                <ToggleButton x:Name="RazorButton" Content="Razor" Height="32" Margin="0,0,4,0" Click="Razor_Click" ToolTip="Click an item to cut it there (C). Alt+click does the same."/>
                <Button Content="Split" Height="32" Margin="0,0,4,0" Click="Split_Click" ToolTip="Cut the selected items at the playhead (S)"/>
                <Button Content="Delete" Height="32" Margin="0,0,4,0" Click="Delete_Click" ToolTip="Delete the selected items (Delete). Shift+Delete closes the gap."/>
                <Button x:Name="UnlinkButton" Content="Unlink" Height="32" Margin="0,0,14,0" Click="Unlink_Click" ToolTip="Let the picture and its sound be moved on their own"/>
                <Button x:Name="TransitionButton" Content="Transition" Height="32" Margin="0,0,4,0" Click="Transition_Click" ToolTip="Fade pictures and sound through black where two items meet (select one of them first)"/>
                <Button Content="Add lane" Height="32" Click="AddLane_Click" ToolTip="Add a picture lane or a sound lane. Right-click an empty lane's name to remove it."/>
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <Button Content="Fit" Height="32" Margin="0,0,8,0" Click="Fit_Click" ToolTip="Zoom to fit everything"/>
                <Slider x:Name="ZoomSlider" Width="110" Minimum="0" Maximum="1" VerticalAlignment="Center" ValueChanged="Zoom_Changed" ToolTip="Zoom (Ctrl + mouse wheel on the timeline)"/>
            </StackPanel>
        </Grid>

        <!-- Timeline -->
        <Border x:Name="TimelineCard" Grid.Row="3" Style="{StaticResource Card}" Padding="0" Height="262">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <local:TimelineView x:Name="Tl"/>
                <ScrollBar x:Name="HScroll" Grid.Row="1" Orientation="Horizontal" Margin="118,0,0,0" ValueChanged="HScroll_Changed"/>
            </Grid>
        </Border>

        <!-- The page when no edit is open -->
        <Border x:Name="StartPanel" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Margin="-16,-12,-16,-14">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="460">
                <TextBlock Text="Editor" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Cut, arrange and fade clips, add text and pictures, then export a video. You don't need a clip to start: add them from the list on the left once you're in." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="New edit" Height="38" MinWidth="120" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="StartNew_Click"/>
                    <Button Content="Open a saved edit…" Height="38" Click="StartOpen_Click"/>
                </StackPanel>
                <TextBlock x:Name="RecentHeader" Text="Recent edits" FontWeight="SemiBold" Margin="0,26,0,8"/>
                <ListBox x:Name="RecentList" MaxHeight="260" BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontSize="14"/>
                                <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="You can also drop a saved edit onto the window." Style="{StaticResource Caption}" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
