<UserControl x:Class="Buffered.UI.ClipPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Buffered.UI"
             Focusable="True" PreviewKeyDown="Player_PreviewKeyDown">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Height="36" Padding="14,0" Click="Back_Click" AutomationProperties.Name="Back to clips">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Clips" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Height="36" Padding="14,0" Click="External_Click" ToolTip="Open in your default video player" AutomationProperties.Name="Open externally">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open externally" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="254"/>
                </Grid.ColumnDefinitions>

                <!-- Video, transport, hints -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="8" Background="Black" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform"
                                          MediaOpened="Video_MediaOpened" MediaFailed="Video_MediaFailed" MediaEnded="Video_MediaEnded"
                                          MouseLeftButtonUp="Video_Click"/>
                            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Width="40" Height="36" Padding="0" Click="Play_Click" ToolTip="Play or pause (Space)"
                                AutomationProperties.Name="Play or pause" FontFamily="{StaticResource IconFont}" FontSize="16" Content="&#xE769;"/>
                        <TextBlock x:Name="TimeText" Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center" FontSize="12" MinWidth="96"/>
                        <local:TrimBar x:Name="Bar" Grid.Column="2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Margin="12,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE767;" Opacity="0.7"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="4" Width="90" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Style="{StaticResource Kbd}" Margin="0,0,2,0"><TextBlock Text="Space" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="play" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="I" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="start" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="O" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="end" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="←" FontSize="11" Opacity="0.7"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="→" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="seek (Shift for 1 s)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Trim panel -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                  <!-- Right margin leaves a gutter for the scrollbar so it sits beside the cards, not on their edge -->
                  <StackPanel Margin="0,0,14,0">
                    <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Trim" FontWeight="SemiBold" FontSize="14"/>

                            <TextBlock Text="Start" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="StartBox" Height="34" VerticalContentAlignment="Center" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown"/>
                                <Button Grid.Column="1" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="Set to the playhead (I)" AutomationProperties.Name="Set start to playhead"
                                        FontFamily="{StaticResource IconFont}" Content="&#xE81D;" Click="SetStart_Click"/>
                            </Grid>

                            <TextBlock Text="End" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="EndBox" Height="34" VerticalContentAlignment="Center" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown"/>
                                <Button Grid.Column="1" Width="34" Height="34" Padding="0" Margin="6,0,0,0" ToolTip="Set to the playhead (O)" AutomationProperties.Name="Set end to playhead"
                                        FontFamily="{StaticResource IconFont}" Content="&#xE81D;" Click="SetEnd_Click"/>
                            </Grid>

                            <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="KeepText" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Method" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                            <Border Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="PreciseRadio" GroupName="trim" Style="{StaticResource SegButton}" Content="Precise" IsChecked="True" Checked="Method_Checked"/>
                                    <RadioButton x:Name="FastRadio" GroupName="trim" Style="{StaticResource SegButton}" Content="Fast" Checked="Method_Checked"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="MethodHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="1,8,0,0"/>

                            <Button x:Name="SaveCopyButton" Margin="0,18,0,0" Height="36" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Save trimmed copy" Click="SaveCopy_Click">
                                <StackPanel x:Name="SaveContent" Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C6;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save copy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReplaceButton" Margin="0,8,0,0" Height="36" HorizontalAlignment="Stretch" Content="Replace original" Click="Replace_Click"/>
                            <Button x:Name="ResetButton" Margin="0,8,0,0" Height="36" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Content="Reset" Click="Reset_Click"/>
                            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="BusyText" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio: shown only when the clip has its companion file (the separate Game and Mic tracks) -->
                    <Border x:Name="AudioCard" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Audio" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Make a track louder or quieter in this clip." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <StackPanel x:Name="AudioRows" Margin="0,6,0,0"/>

                            <TextBlock x:Name="AudioHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
