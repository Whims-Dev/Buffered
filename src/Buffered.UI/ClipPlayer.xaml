<UserControl x:Class="Buffered.UI.ClipPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Buffered.UI"
             Focusable="True" FocusVisualStyle="{x:Null}" PreviewKeyDown="Player_PreviewKeyDown">
    <!-- No background of its own: like the other pages it shows the window's backdrop. An opaque one painted over the
         bottom edge of the window's caption buttons (most visible on the red close button when hovered). -->
    <Grid>
        <Grid Margin="26,20,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Width="36" Height="36" Padding="0" Click="Back_Click" ToolTip="Back to clips" AutomationProperties.Name="Back to clips">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" VerticalAlignment="Center"/>
                </Button>
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Height="36" Padding="14,0" Margin="0,0,6,0" Click="External_Click" Background="Transparent" BorderBrush="Transparent" ToolTip="Open in your default video player" AutomationProperties.Name="Open externally">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Open externally" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Height="36" Padding="14,0" Click="Share_Click" ToolTip="Make a smaller copy that fits a chat app's upload limit" AutomationProperties.Name="Share">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72D;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Share" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="GearButton" Grid.Column="4" Width="36" Height="36" Padding="0" Margin="6,0,0,0" Click="Gear_Click" ToolTip="Editor settings" AutomationProperties.Name="Editor settings">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" VerticalAlignment="Center"/>
                </Button>
                <Popup x:Name="GearPopup" Grid.Column="4" PlacementTarget="{Binding ElementName=GearButton}" Placement="Bottom" HorizontalOffset="-272" VerticalOffset="4"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="300" Margin="14" CornerRadius="12" Padding="14" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource ApplicationBackgroundBrush}">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/></Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Editor" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Timeline detail" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                            <StackPanel x:Name="GearOptions"/>
                            <TextBlock Text="Moving the playhead while playing" Style="{StaticResource Caption}" Margin="0,10,0,6"/>
                            <StackPanel x:Name="GearScrubOptions"/>
                            <Border Height="1" Margin="0,10,0,0" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Button x:Name="GearMore" Margin="0,6,0,0" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,0" Background="Transparent" BorderBrush="Transparent"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Click="GearMore_Click" AutomationProperties.Name="All editor settings in Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="All editor settings in Settings" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="254"/>
                </Grid.ColumnDefinitions>

                <!-- Video, transport, hints -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- The picture itself is rounded (its frame is sized to the video's shape), so there is no dark box around it -->
                    <Grid x:Name="VideoHost" Grid.Row="0" SizeChanged="VideoHost_SizeChanged">
                        <Grid x:Name="VideoFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0E0E0E" SizeChanged="VideoFrame_SizeChanged">
                            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Fill"
                                          MediaOpened="Video_MediaOpened" MediaFailed="Video_MediaFailed" MediaEnded="Video_MediaEnded"
                                          MouseLeftButtonUp="Video_Click"/>
                            <!-- A still of the current picture, held over the video while its file is swapped, so the picture never blinks out -->
                            <Image x:Name="SwapCover" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <!-- The clip's thumbnail, shown at once while the video loads, then faded out -->
                            <Image x:Name="Poster" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed"/>
                            <!-- While the clip loads: what is happening, and a sliding bar along the bottom (inside the frame, so its rounded corners cut the bar off) -->
                            <Border x:Name="LoadPill" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Padding="14,5" CornerRadius="16"
                                    Background="#99000000" BorderThickness="1" BorderBrush="#2EFFFFFF" IsHitTestVisible="False">
                                <TextBlock x:Name="LoadText" Foreground="White" FontSize="12" Text="Opening clip…"/>
                            </Border>
                            <Grid x:Name="LoadBar" Visibility="Collapsed" Height="4" VerticalAlignment="Bottom" ClipToBounds="True" Background="#1FFFFFFF" IsHitTestVisible="False" SizeChanged="LoadBar_SizeChanged">
                                <Rectangle x:Name="LoadSlider" HorizontalAlignment="Left" Fill="{DynamicResource AccentFillColorDefaultBrush}">
                                    <Rectangle.RenderTransform><TranslateTransform x:Name="LoadMove"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <Border x:Name="VideoEdge" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" IsHitTestVisible="False"/>
                        </Grid>
                        <!-- Shown while paused; clicks pass through to the video -->
                        <Border x:Name="BigPlay" Width="64" Height="64" CornerRadius="32" Background="#8C000000" BorderThickness="1" BorderBrush="#40FFFFFF" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                        </Border>
                        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"/>
                    </Grid>

                    <!-- Transport: play, time, timeline, volume, shortcuts -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12,16,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlayButton" Width="40" Height="40" Padding="0" Click="Play_Click" ToolTip="Play or pause (Space)" Cursor="Hand"
                                        AutomationProperties.Name="Play or pause" FontFamily="{StaticResource IconFont}" FontSize="16" Content="&#xE769;"
                                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="20" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock x:Name="TimeText" Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center" FontSize="13" MinWidth="104"/>
                                <local:TrimBar x:Name="Bar" Grid.Column="2" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Margin="12,0,6,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Text="&#xE767;" Opacity="0.7"/>
                                <Slider x:Name="VolumeSlider" Grid.Column="4" Width="90" Minimum="0" Maximum="1" Value="1" LargeChange="0.1" SmallChange="0.05" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Style="{StaticResource Kbd}" Margin="0,0,2,0"><TextBlock Text="Space" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="play" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <Border Style="{StaticResource Kbd}"><TextBlock Text="I" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="set start" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <Border Style="{StaticResource Kbd}"><TextBlock Text="O" FontSize="11" Opacity="0.7"/></Border><TextBlock Text="set end" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <Border Style="{StaticResource Kbd}"><TextBlock Text="&#x2190;" FontSize="11" Opacity="0.7"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="&#x2192;" FontSize="11" Opacity="0.7"/></Border><TextBlock x:Name="SeekHint" Text="seek 5 s (Shift: 1 s)" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                <Border Style="{StaticResource Kbd}"><TextBlock Text="," FontSize="11" Opacity="0.7"/></Border><Border Style="{StaticResource Kbd}"><TextBlock Text="." FontSize="11" Opacity="0.7"/></Border><TextBlock Text="frame" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Trim panel -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                  <!-- Right margin leaves a gutter for the scrollbar so it sits beside the cards, not on their edge -->
                  <StackPanel Margin="0,0,14,0">
                    <Border Style="{StaticResource Card}" Padding="16" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Trim" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="TrimState" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Whole clip"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="10,7,6,6">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="START" Style="{StaticResource Caption}" FontSize="10.5"/>
                                            <TextBox x:Name="StartBox" MinHeight="0" Height="26" Padding="0" Margin="0,2,0,0" BorderThickness="0" Background="Transparent" FontSize="16" FontWeight="SemiBold"
                                                     VerticalContentAlignment="Center" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" AutomationProperties.Name="Start time"/>
                                        </StackPanel>
                                        <Button Width="26" Height="26" MinHeight="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                                                ToolTip="Set to the playhead (I)" AutomationProperties.Name="Set start to playhead" Click="SetStart_Click">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81D;" FontSize="13" Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="10,7,6,6">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="END" Style="{StaticResource Caption}" FontSize="10.5"/>
                                            <TextBox x:Name="EndBox" MinHeight="0" Height="26" Padding="0" Margin="0,2,0,0" BorderThickness="0" Background="Transparent" FontSize="16" FontWeight="SemiBold"
                                                     VerticalContentAlignment="Center" LostFocus="TimeBox_LostFocus" KeyDown="TimeBox_KeyDown" AutomationProperties.Name="End time"/>
                                        </StackPanel>
                                        <Button Width="26" Height="26" MinHeight="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent"
                                                ToolTip="Set to the playhead (O)" AutomationProperties.Name="Set end to playhead" Click="SetEnd_Click">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81D;" FontSize="13" Opacity="0.75"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- How much is kept: a figure and a bar showing where it sits in the clip -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <TextBlock x:Name="KeepBig" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="KeepOf" Style="{StaticResource Caption}" Margin="8,0,0,4" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Grid Height="6" Margin="0,8,0,0">
                                <Border CornerRadius="3" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="KeepCol0" Width="0*"/>
                                        <ColumnDefinition x:Name="KeepCol1" Width="1*"/>
                                        <ColumnDefinition x:Name="KeepCol2" Width="0*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </Grid>
                            </Grid>

                            <Border x:Name="KeepNote" Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <TextBlock x:Name="KeepText" FontSize="12" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="Method" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                            <Border Height="36" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <UniformGrid Rows="1">
                                    <RadioButton x:Name="PreciseRadio" GroupName="trim" Style="{StaticResource SegButton}" Content="Precise" IsChecked="True" Checked="Method_Checked"/>
                                    <RadioButton x:Name="FastRadio" GroupName="trim" Style="{StaticResource SegButton}" Content="Fast" Checked="Method_Checked"/>
                                </UniformGrid>
                            </Border>
                            <TextBlock x:Name="MethodHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="1,8,0,0"/>

                            <Button x:Name="SaveCopyButton" Margin="0,18,0,0" Height="36" HorizontalAlignment="Stretch" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Save trimmed copy" Click="SaveCopy_Click">
                                <StackPanel x:Name="SaveContent" Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C6;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Save copy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ReplaceButton" Margin="0,8,0,0" Height="36" HorizontalAlignment="Stretch" Content="Replace original" Click="Replace_Click"/>
                            <Button x:Name="ResetButton" Margin="0,8,0,0" Height="36" HorizontalAlignment="Stretch" Background="Transparent" BorderBrush="Transparent" Content="Reset" Click="Reset_Click"/>
                            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="BusyText" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio: shown only when the clip has its companion file (the separate Game and Mic tracks) -->
                    <Border x:Name="AudioCard" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Audio" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="Make a track louder or quieter in this clip." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <StackPanel x:Name="AudioRows" Margin="0,6,0,0"/>

                            <TextBlock x:Name="AudioHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Share: make a smaller copy that fits a chat app's upload limit -->
        <Grid x:Name="ShareScrim" Visibility="Collapsed" Background="#8C000000" PreviewKeyDown="Share_PreviewKeyDown" SizeChanged="ShareScrim_SizeChanged" MouseLeftButtonDown="ShareScrim_MouseDown" MouseLeftButtonUp="ShareScrim_MouseUp">
            <Border x:Name="ShareCard" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="28,26,16,24"
                    Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Share this clip" FontSize="16" FontWeight="SemiBold" Margin="0,0,40,0"/>
                            <TextBlock x:Name="ShareIntro" Text="Pick a size, then make a copy or send it to a Discord channel." Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75" LineHeight="20"/>
                            <UniformGrid x:Name="ShareOptions" Rows="1" Margin="0,16,0,0"/>
                            <TextBlock x:Name="ShareEstimate" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.8" MinHeight="34" LineHeight="18"/>

                            <TextBlock x:Name="ShareToLabel" Text="Send to" FontSize="12" Opacity="0.7" Margin="0,8,0,0"/>
                            <WrapPanel x:Name="SharePills" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ShareNoHooks" Text="Add a Discord webhook from the three dots to send clips straight to a channel." FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <StackPanel x:Name="ShareManage" Visibility="Collapsed" Margin="0,14,0,0">
                                <TextBlock Text="Your webhooks" FontSize="12" Opacity="0.7"/>
                                <local:WebhookEditor x:Name="ShareEditor" Margin="0,6,0,0"/>
                            </StackPanel>

                            <ProgressBar x:Name="ShareBar" Height="4" Margin="0,14,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                            <TextBlock x:Name="ShareResult" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>
                            <StackPanel x:Name="ShareLinks" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                                <Button x:Name="ShareOpenLink" Height="30" Padding="10,0" MinHeight="0" Margin="0,0,6,0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Content="Open in Discord" Click="ShareOpenLink_Click"/>
                                <Button x:Name="ShareCopyLink" Height="30" Padding="10,0" MinHeight="0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Content="Copy link" Click="ShareCopyLink_Click"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                <Button x:Name="ShareClose" Height="34" MinWidth="84" Padding="14,0" Margin="0,0,8,0" Content="Close" Click="ShareClose_Click"/>
                                <Button x:Name="ShareGo" Height="34" MinWidth="84" Padding="14,0" Margin="0,0,8,0" Content="Make smaller copy" Click="ShareGo_Click"/>
                                <Button x:Name="ShareSend" Height="34" MinWidth="84" MaxWidth="240" Padding="14,0" Click="ShareSend_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="ShareMore" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,-4,0" Width="32" Height="32" MinHeight="0" Padding="0"
                            Background="Transparent" BorderBrush="Transparent" ToolTip="More options"
                            AutomationProperties.Name="More share options" Click="ShareMore_Click">
                        <!-- The icon font is set on the glyph only: the menu below inherits the button's font, and in the icon font its text is boxes. -->
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE712;" FontSize="16"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Manage webhooks…" Click="ShareManage_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
