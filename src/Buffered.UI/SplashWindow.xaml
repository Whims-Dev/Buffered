<Window x:Class="Buffered.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buffered starting" Width="460" Height="260" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen" ThemeMode="System"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!--
      A small centred picture shown while the clip manager opens. It follows the Windows light or dark setting.
      It is an ordinary window (not a see-through one), so Windows draws its animation itself and the loading bar keeps moving smoothly
      while the clip manager's window is being built behind it. Only the contents fade, never the window.
    -->
    <Border x:Name="Root" Opacity="0" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
        <Grid ClipToBounds="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-6,0,0">
                <Image Source="/Assets/logo.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Buffered" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>

            <TextBlock Text="Loading…" FontSize="12" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,16"/>
            <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,16"/>

            <!-- The bar slides along the bottom edge. -->
            <Border Height="3" VerticalAlignment="Bottom" ClipToBounds="True" Background="#33808080">
                <Rectangle x:Name="Slider" Width="156" HorizontalAlignment="Left" Fill="#C9C46A">
                    <Rectangle.RenderTransform><TranslateTransform x:Name="SlideMove" X="-156"/></Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
