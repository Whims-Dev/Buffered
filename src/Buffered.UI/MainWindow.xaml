                                    <TextBlock Text="Shortcuts"/>
                                    <TextBlock x:Name="ShortcutText" Text="Add Buffered to your desktop or Start menu. Click a green one again to remove it." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="DesktopShortcutButton" Height="34" MinWidth="110" Padding="14,0" Margin="0,0,8,0" Click="DesktopShortcut_Click" AutomationProperties.Name="Desktop shortcut">
                                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="DesktopGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" Margin="0,1,8,0" VerticalAlignment="Center"/><TextBlock x:Name="DesktopLabel" Text="Desktop" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
                                        </Button>
                                        <Button x:Name="StartMenuShortcutButton" Height="34" MinWidth="130" Padding="14,0" Click="StartMenuShortcut_Click" AutomationProperties.Name="Start menu shortcut">
                                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="StartMenuGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" Margin="0,1,8,0" VerticalAlignment="Center"/><TextBlock x:Name="StartMenuLabel" Text="Start menu" TextWrapping="NoWrap" VerticalAlignment="Center"/></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="Compress audio in memory"/><TextBlock Text="Holds the buffered audio at half the size, saving about 45 MB of RAM with a 5 minute buffer. Costs almost no CPU, but adds a faint hiss under very quiet sounds. Restarts recording." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                <CheckBox x:Name="CompressBox" Grid.Column="1" Style="{StaticResource SwitchBox}" VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Compress audio in memory"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="UpdateTitle" Text="Updates"/>
                                        <Border x:Name="UpdatePill" Visibility="Collapsed" Margin="10,0,0,0" Padding="9,1" CornerRadius="10" Background="#29C9C46A" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdatePillText" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="UpdateText" Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <Border x:Name="UpdateNotes" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="What's new" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>
                                    <ProgressBar x:Name="UpdateBar" Visibility="Collapsed" Height="6" MinHeight="0" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button x:Name="UpdatePrimary" Height="34" MinWidth="150" Padding="14,0" Click="UpdatePrimary_Click" AutomationProperties.Name="Update">
                                        <TextBlock x:Name="UpdatePrimaryText" Text="Check for updates" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="UpdateSecondary" Visibility="Collapsed" Height="30" Margin="0,6,0,0" Padding="10,0" Background="Transparent" BorderBrush="Transparent"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Click="UpdateSecondary_Click" AutomationProperties.Name="More about this update">
                                        <TextBlock x:Name="UpdateSecondaryText" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,24,0"><TextBlock Text="Discord webhooks"/><TextBlock Text="Places you can send a clip with one click. Drag the handle to reorder; the order is the same in the share window. A webhook link lets anyone post in that channel, so keep it private. It is saved only on this PC." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                <local:WebhookEditor x:Name="WebhookList" Grid.Row="1" Margin="0,10,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
              </StackPanel>
            </Grid>

            <!-- Player and trimmer: covers the content area while a clip is open -->
            <local:ClipPlayer x:Name="Player" Visibility="Collapsed"/>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusStrip" Grid.Row="1" Grid.ColumnSpan="2" Height="34" Padding="14,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid SizeChanged="StatusBar_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Connecting…" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="PauseButton" Style="{StaticResource SmallButton}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Click="PauseButton_Click" AutomationProperties.Name="Pause or resume recording">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE769;" Margin="0,1,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartRecorderButton" Content="Start recorder" Style="{StaticResource SmallButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Click="StartRecorderButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock x:Name="BufferText" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BufferBar" Width="96" Height="4" Margin="10,0,0,0" Maximum="100" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
<Border x:Name="MetersHost">
                                        <StackPanel x:Name="AudioMeters" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="Collapsed"
                                ToolTip="Live audio levels. If Game stays empty while you can hear sound, the wrong output device is being recorded.">
                        <TextBlock Text="Game" FontSize="12" Opacity="0.8" Margin="0,0,6,0"/>
                        <ProgressBar x:Name="GameMeter" Width="44" Height="4" Maximum="100" Margin="0,0,14,0"/>
                        <TextBlock Text="Mic" FontSize="12" Opacity="0.8" Margin="0,0,6,0"/>
                        <ProgressBar x:Name="MicMeter" Width="44" Height="4" Maximum="100"/>
                    </StackPanel>
                    </Border>
                    <TextBlock x:Name="VramText" FontSize="12" Opacity="0.8" Margin="0,0,18,0"/>
                    <TextBlock x:Name="CpuText" FontSize="12" Opacity="0.8" Margin="0,0,18,0"/>
                    <TextBlock x:Name="QualityText" FontSize="12" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dialogs and notices sit above everything -->
        <local:DialogHost x:Name="Dialogs" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

        <!-- Shown for a moment when the zoom changes -->
        <Border x:Name="ZoomPill" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,52" Padding="16,6,6,6" CornerRadius="20"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ZoomText" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="44"/>
                <Button Height="28" MinHeight="0" Padding="14,0" Margin="8,0,0,0" FontSize="12" Content="Reset" Click="ZoomReset_Click" AutomationProperties.Name="Reset zoom" Cursor="Hand">
                    <Button.Template>
                        <!-- Fully rounded, to sit inside the pill's own curve -->
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="14" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
