<Window x:Class="Buffered.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Buffered.UI"
        Title="Buffered" Width="1000" Height="720" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" ThemeMode="System"
        SizeChanged="Window_SizeChanged" Closed="Window_Closed">
    <Window.Resources>
        <!-- A row in the folder list on the left of the clips page -->
        <Style x:Key="RailItem" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Long device names end in an ellipsis (full name on hover) instead of being cut off -->
        <DataTemplate x:Key="TrimmedLabel">
            <TextBlock Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation rail -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                <Image Source="/Assets/logo.png" Width="34" Height="34" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                <RadioButton x:Name="NavClips" GroupName="nav" Style="{StaticResource NavButton}" Content="&#xE80A;" IsChecked="True"
                             ToolTip="Clips" AutomationProperties.Name="Clips" Checked="Nav_Checked"/>
                <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavButton}" Content="&#xE713;"
                             ToolTip="Settings" AutomationProperties.Name="Settings" Checked="Nav_Checked"/>
            </StackPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Row="0" Grid.Column="1">
            <!-- Clips -->
            <Grid x:Name="ClipsPage">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Folders -->
              <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="10,20,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <StackPanel x:Name="RailTop"/>
                    <Grid Margin="10,16,0,4">
                        <TextBlock Text="Folders" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Width="28" Height="28" MinHeight="0" Padding="0" Background="Transparent" BorderBrush="Transparent"
                                FontFamily="{StaticResource IconFont}" Content="&#xE8F4;" FontSize="14" ToolTip="New folder" AutomationProperties.Name="New folder" Click="NewFolder_Click"/>
                    </Grid>
                    <StackPanel x:Name="RailFolders"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>

              <Grid Grid.Column="1" Margin="26,20,26,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Shown instead of the title and search while clips are selected -->
                <Grid x:Name="SelectionBar" Grid.Row="0" Margin="0,0,0,16" Height="50" Visibility="Collapsed" Panel.ZIndex="2" Background="{DynamicResource ApplicationBackgroundBrush}">
                    <TextBlock x:Name="SelectionText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SelFavorite" Height="36" Padding="14,0" Margin="0,0,8,0" Click="SelFavorite_Click" AutomationProperties.Name="Favorite">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE734;" Margin="0,1,8,0" VerticalAlignment="Center"/><TextBlock x:Name="SelFavoriteLabel" Text="Favorite" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="SelMove" Height="36" Padding="14,0" Margin="0,0,8,0" Click="SelMove_Click" AutomationProperties.Name="Move to folder">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8DA;" Margin="0,1,8,0" VerticalAlignment="Center"/><TextBlock Text="Move to" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Height="36" Padding="14,0" Margin="0,0,8,0" Click="SelDelete_Click" AutomationProperties.Name="Delete selected">
                            <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,1,8,0" VerticalAlignment="Center"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button Width="36" Height="36" Padding="0" Click="SelClear_Click" ToolTip="Clear selection" AutomationProperties.Name="Clear selection"
                                FontFamily="{StaticResource IconFont}" Content="&#xE711;" FontSize="13"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clips" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ClipMeta" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Width="200" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchHint" Text="Search clips" IsHitTestVisible="False" Opacity="0.5" VerticalAlignment="Center" Margin="11,0,0,0"/>
                    </Grid>
                    <Button x:Name="SaveButton" Grid.Column="2" Height="36" Padding="14,0" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="Save clip" Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SaveLabel" Text="Save clip" VerticalAlignment="Center"/>
                            <Border Margin="10,0,0,0" Padding="6,3" CornerRadius="5" Background="#33808080" VerticalAlignment="Center">
                                <TextBlock x:Name="HotkeyChip" Text="F8" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel x:Name="FilterPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"/>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Background="Transparent"
                                  PreviewMouseLeftButtonDown="Scroller_Down" PreviewMouseMove="Scroller_Move" PreviewMouseLeftButtonUp="Scroller_Up">
                        <ItemsControl x:Name="GroupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource Caption}" Margin="0,2,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Clips}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel x:Name="CardRoot" Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,14,18">
                                                        <Border x:Name="Thumb" CornerRadius="8" Background="{Binding Tint}" Cursor="Hand" ClipToBounds="True"
                                                                Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                MouseLeftButtonDown="Card_Down" MouseMove="Card_Move" MouseLeftButtonUp="Card_Click" MouseRightButtonUp="Card_RightClick">
                                                            <Grid>
                                                                <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                                <Border x:Name="SelRing" BorderThickness="3" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"
                                                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="#22FFFFFF"/>
                                                                <Border x:Name="SelDot" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Opacity="0"
                                                                        Background="#80000000" BorderBrush="#CCFFFFFF" BorderThickness="1.5" Cursor="Hand" MouseLeftButtonUp="Check_Click">
                                                                    <TextBlock x:Name="SelTick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" Visibility="Collapsed"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                                                </Border>
                                                                <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False"/>
                                                                <Border CornerRadius="4" Padding="6,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#B8000000" IsHitTestVisible="False">
                                                                    <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="White"/>
                                                                </Border>
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                                                    <StackPanel x:Name="Overlay" Orientation="Horizontal" Opacity="0">
                                                                        <Button Style="{StaticResource OverlayButton}" Content="&#xE8A7;" ToolTip="Open in your default player" AutomationProperties.Name="Open externally" Click="External_Click"/>
                                                                        <Button Style="{StaticResource OverlayButton}" Content="&#xE8B7;" ToolTip="Show in folder" AutomationProperties.Name="Show in folder" Click="Folder_Click"/>
                                                                        <Button Style="{StaticResource OverlayButton}" Content="&#xE74D;" ToolTip="Delete" AutomationProperties.Name="Delete" Click="Delete_Click"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="StarBtn" Style="{StaticResource OverlayButton}" Content="&#xE734;" Opacity="0" ToolTip="Favorite" AutomationProperties.Name="Favorite" Click="Star_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Tip}" FontSize="13" Margin="1,9,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="1,5,0,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="PlayGlyph" Property="Opacity" Value="0.92"/>
                                                            <Setter TargetName="SelDot" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="StarBtn" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter TargetName="SelDot" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="PlayGlyph" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="SelRing" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="SelDot" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="SelDot" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                            <Setter TargetName="SelDot" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                            <Setter TargetName="SelTick" Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter TargetName="StarBtn" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="StarBtn" Property="Content" Value="&#xE735;"/>
                                                            <Setter TargetName="StarBtn" Property="Foreground" Value="#F2C14E"/>
                                                            <Setter TargetName="StarBtn" Property="ToolTip" Value="Remove from favorites"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle" Text="Save your first clip" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyBody" Opacity="0.7" Margin="0,8,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                    <Canvas x:Name="BandLayer" IsHitTestVisible="False">
                        <Border x:Name="Band" Visibility="Collapsed" BorderThickness="1" CornerRadius="2"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" Background="#334C8DF0"/>
                    </Canvas>
                </Grid>
              </Grid>
            </Grid>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,20,26,24">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Video" Style="{StaticResource Caption}" Margin="18,14,18,2"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Monitor"/><TextBlock Text="The display to record" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <ComboBox x:Name="MonitorBox" Width="300" HorizontalAlignment="Right" SelectionChanged="Setting_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,380,0"><TextBlock Text="Record game windows"/><TextBlock Text="Record only the game, not the whole monitor." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="360">
                                    <WrapPanel x:Name="GameChips"/>
                                    <Button x:Name="AddGameButton" Content="+ Add game" Height="30" Padding="14,0" Margin="0,2,0,2" Click="AddGame_Click" AutomationProperties.Name="Add a game">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Pill" CornerRadius="15" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Popup x:Name="GamePopup" PlacementTarget="{Binding ElementName=AddGameButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Width="300" Margin="6" Padding="6" CornerRadius="10" Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBox x:Name="GameSearch" TextChanged="GameSearch_Changed" ToolTip="Search open windows, or type a name" AutomationProperties.Name="Search open windows"/>
                                                <TextBlock Text="Open now" Style="{StaticResource Caption}" Margin="6,10,0,4"/>
                                                <ListBox x:Name="GameList" MaxHeight="200" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="GameList_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                            <Setter Property="Padding" Value="8,0"/>
                                                            <Setter Property="MinHeight" Value="34"/>
                                                            <Setter Property="Margin" Value="0,1"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Process}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </WrapPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,70,0"><TextBlock Text="Keep game windows visible"/><TextBlock Text="Restores a minimized game behind your other windows so recording continues. If off, the monitor is recorded while it's minimized." Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                <CheckBox x:Name="KeepVisibleBox" Style="{StaticResource SwitchBox}" HorizontalAlignment="Right" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Keep game windows visible"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Quality"/><TextBlock Text="Resolution and frame rate of saved clips" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="ResolutionBox" Width="146" Margin="0,0,8,0" SelectionChanged="Setting_Changed"/>
                                    <ComboBox x:Name="FpsBox" Width="146" SelectionChanged="Setting_Changed"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Buffer length"/><TextBlock x:Name="RamHint" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <ComboBox x:Name="BufferBox" Width="300" HorizontalAlignment="Right" SelectionChanged="Setting_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Audio" Style="{StaticResource Caption}" Margin="18,14,18,2"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Game audio"/><TextBlock Text="What your output device is playing" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <ComboBox x:Name="GameAudioBox" Width="300" HorizontalAlignment="Right" ItemTemplate="{StaticResource TrimmedLabel}" SelectionChanged="Setting_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Ignore Windows volume"/><TextBlock Text="Windows turns game audio down before it can be recorded, so a low volume makes clips quiet. This restores the full level." Style="{StaticResource Caption}" Margin="0,5,60,0" TextWrapping="Wrap"/></StackPanel>
                                <CheckBox x:Name="CompBox" Style="{StaticResource SwitchBox}" HorizontalAlignment="Right" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Ignore Windows volume for game audio"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Microphone"/><TextBlock Text="Mixed in with the game sound in each clip" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <ComboBox x:Name="MicBox" Width="300" HorizontalAlignment="Right" ItemTemplate="{StaticResource TrimmedLabel}" SelectionChanged="Setting_Changed"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Game volume"/><TextBlock Text="Louder or quieter game sound in new clips. Applies to your next clip." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="GameGainSlider" Width="230" Minimum="-20" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="Gain_Changed" AutomationProperties.Name="Game volume in decibels"/>
                                    <TextBlock x:Name="GameGainText" Width="64" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Opacity="0.8" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Mic volume"/><TextBlock Text="Louder or quieter microphone in new clips. Applies to your next clip." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Slider x:Name="MicGainSlider" Width="230" Minimum="-20" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="Gain_Changed" AutomationProperties.Name="Microphone volume in decibels"/>
                                    <TextBlock x:Name="MicGainText" Width="64" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Opacity="0.8" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Keep Game and Mic as separate tracks"/><TextBlock Text="Clips always get a mixed track. Separate tracks help when editing in another app, but some players, including Windows' own, only play one of several tracks." Style="{StaticResource Caption}" Margin="0,5,60,0" TextWrapping="Wrap"/></StackPanel>
                                <CheckBox x:Name="TracksBox" Style="{StaticResource SwitchBox}" HorizontalAlignment="Right" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Keep Game and Mic as separate tracks"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Switch for SteamVR"/><TextBlock Text="Use the Steam Streaming devices while SteamVR is running. Switching restarts recording." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <CheckBox x:Name="VrBox" Style="{StaticResource SwitchBox}" HorizontalAlignment="Right" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Switch for SteamVR"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="General" Style="{StaticResource Caption}" Margin="18,14,18,2"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Save hotkey"/><TextBlock Text="Click, then press the key you want" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <Button x:Name="HotkeyButton" Width="300" HorizontalAlignment="Right" HorizontalContentAlignment="Left"
                                        Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown" LostKeyboardFocus="HotkeyButton_LostFocus"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,320,0"><TextBlock Text="Clips folder"/><TextBlock x:Name="FolderText" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                <Button HorizontalAlignment="Right" Height="34" Padding="14,0" Click="BrowseFolder_Click" AutomationProperties.Name="Browse for clips folder">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Sound when a clip is saved"/><TextBlock Text="A short sound when you save with the hotkey. Buffered never shows Windows notifications, so full-screen games aren't interrupted." Style="{StaticResource Caption}" Margin="0,5,60,0" TextWrapping="Wrap"/></StackPanel>
                                <CheckBox x:Name="SoundBox" Style="{StaticResource SwitchBox}" HorizontalAlignment="Right" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Sound when a clip is saved"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                            <Grid Margin="18,12">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Draw this window on the CPU"/><TextBlock Text="Uses no VRAM. Applies the next time the window opens." Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel>
                                <CheckBox x:Name="SoftwareBox" Style="{StaticResource SwitchBox}" HorizontalAlignment="Right" Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="Draw this window on the CPU"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ApplyText" Style="{StaticResource Caption}" Margin="4,0,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Player and trimmer: covers the content area while a clip is open -->
            <local:ClipPlayer x:Name="Player" Visibility="Collapsed"
                              Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

        <!-- Status bar -->
        <Border x:Name="StatusStrip" Grid.Row="1" Grid.ColumnSpan="2" Height="34" Padding="14,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="Connecting…" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <Button x:Name="PauseButton" Style="{StaticResource SmallButton}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                            Click="PauseButton_Click" AutomationProperties.Name="Pause or resume recording">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PauseGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE769;" Margin="0,1,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StartRecorderButton" Content="Start recorder" Style="{StaticResource SmallButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed" Click="StartRecorderButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <TextBlock x:Name="BufferText" FontSize="12" Opacity="0.8" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="BufferBar" Width="96" Height="4" Margin="10,0,0,0" Maximum="100" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="AudioMeters" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" Visibility="Collapsed"
                                ToolTip="Live audio levels. If Game stays empty while you can hear sound, the wrong output device is being recorded.">
                        <TextBlock Text="Game" FontSize="12" Opacity="0.8" Margin="0,0,6,0"/>
                        <ProgressBar x:Name="GameMeter" Width="44" Height="4" Maximum="100" Margin="0,0,14,0"/>
                        <TextBlock Text="Mic" FontSize="12" Opacity="0.8" Margin="0,0,6,0"/>
                        <ProgressBar x:Name="MicMeter" Width="44" Height="4" Maximum="100"/>
                    </StackPanel>
                    <TextBlock x:Name="VramText" FontSize="12" Opacity="0.8" Margin="0,0,18,0"/>
                    <TextBlock x:Name="CpuText" FontSize="12" Opacity="0.8" Margin="0,0,18,0"/>
                    <TextBlock x:Name="QualityText" FontSize="12" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dialogs and notices sit above everything -->
        <local:DialogHost x:Name="Dialogs" Grid.RowSpan="2" Grid.ColumnSpan="2"/>
    </Grid>
</Window>
