<UserControl x:Class="Buffered.UI.DialogHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Dimmed backdrop + dialog card -->
        <Grid x:Name="Scrim" Visibility="Collapsed" Background="#8C000000" PreviewKeyDown="Scrim_PreviewKeyDown" MouseLeftButtonDown="Scrim_MouseDown" MouseLeftButtonUp="Scrim_MouseUp">
            <Border x:Name="Card" Width="420" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="24,22,24,20"
                    Background="{DynamicResource ApplicationBackgroundBrush}" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.75" LineHeight="20"/>
                    <TextBox x:Name="InputBox" Margin="0,14,0,0" Height="34" VerticalContentAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Name"/>
                    <CheckBox x:Name="OptionBox" Margin="0,14,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="ThirdButton" Height="34" MinWidth="84" Padding="14,0" Margin="0,0,8,0" Visibility="Collapsed" Click="Third_Click"/>
                        <Button x:Name="CancelButton" Height="34" MinWidth="84" Padding="14,0" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button x:Name="ConfirmButton" Height="34" MinWidth="84" Padding="14,0" Click="Confirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notice: top centre, out of the way of the controls -->
        <Border x:Name="ToastCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                CornerRadius="10" Padding="14,10,10,10" MaxWidth="420" BorderThickness="1"
                Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.4" Color="Black"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE73E;" FontSize="18" Foreground="#2E9E5B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ToastTitle" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ToastSub" FontSize="11" Opacity="0.6" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="ToastAction" Margin="16,0,0,0" Height="30" Padding="10,0" MinHeight="0" Background="Transparent" BorderBrush="Transparent"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Click="ToastAction_Click"/>
                <Button Margin="4,0,0,0" Width="30" Height="30" MinHeight="0" Padding="0" Background="Transparent" BorderBrush="Transparent"
                        FontFamily="{StaticResource IconFont}" Content="&#xE711;" FontSize="12" Click="ToastClose_Click" AutomationProperties.Name="Dismiss"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
