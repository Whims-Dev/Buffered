<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tries the editor's timeline logic (cut, trim, move, delete, undo) with made-up projects. Run it with "dotnet run" in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Buffered.UI\Editor\TimelineModel.cs" Link="TimelineModel.cs" />
    <Compile Include="..\..\src\Buffered.UI\Editor\Subtitles.cs" Link="Subtitles.cs" />
    <Compile Include="..\..\src\Buffered.UI\Editor\BeatFinder.cs" Link="BeatFinder.cs" />
  </ItemGroup>

</Project>
