<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the ffmpeg command for made-up edits, and (when the machine has ffmpeg and a sample clip) really runs it. Run it with "dotnet run" in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Buffered.UI\TimelineModel.cs" Link="TimelineModel.cs" />
    <Compile Include="..\..\src\Buffered.UI\ExportGraph.cs" Link="ExportGraph.cs" />
  </ItemGroup>

</Project>
